  "changelogUrl": "https://github.com/louie850909/kawaii-physics-unity/blob/main/CHANGELOG.md",
  "licensesUrl": "https://github.com/louie850909/kawaii-physics-unity/blob/main/LICENSE.md",
  "dependencies": {
    "com.unity.burst": "2.0.0",
    "com.unity.mathematics": "1.4.0",
    "com.unity.collections": "6.6.0",
